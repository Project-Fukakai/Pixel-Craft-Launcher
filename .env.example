# PCL-CE environment variables template
#
# Usage:
#   cp .env.example .env
#   set -a && source .env && set +a
#
# Notes:
#   - Runtime secrets are read from variables with the PCL_ prefix.
#   - In Debug builds, most secrets can be read directly from the environment.
#   - Set PCL_WRITE_SECRET=1 before build only when you need the source generator
#     to embed PCL_* variables into generated code.

# Enable build-time secret embedding via PCL.Core.SourceGenerators.
# Leave empty or unset for normal local development.
PCL_WRITE_SECRET=

# Microsoft OAuth Client ID.
PCL_MS_CLIENT_ID=

# CurseForge API key.
PCL_CURSEFORGE_API_KEY=

# Telemetry bearer token.
PCL_TELEMETRY_KEY=

# Compatibility key used by LobbyController.GetSecret("TelemetryKey").
PCL_TelemetryKey=

# Natayark ID OAuth credentials.
PCL_NAID_CLIENT_ID=
PCL_NAID_CLIENT_SECRET=

# Link server roots, separated by "|".
# Example: PCL_LINK_SERVER_ROOT="https://server-a.example|https://server-b.example"
PCL_LINK_SERVER_ROOT=

# Sentry DSN for telemetry.
PCL_SENTRY_DSN=

# Git commit SHA for build metadata.
PCL_GITHUB_SHA=

# Debug-only path overrides.
PCL_PATH=
PCL_PATH_SHARED=
PCL_PATH_LOCAL=
PCL_PATH_TEMP=
