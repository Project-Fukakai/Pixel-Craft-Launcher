<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pixel_Craft_Launcher.Views.Setup.SettingRow">
  <Grid ColumnDefinitions="180,*"
        RowDefinitions="Auto,Auto"
        ColumnSpacing="14">
    <TextBlock x:Name="TitleBlock"
               Grid.Row="0"
               Grid.Column="0"
               VerticalAlignment="Center"
               FontSize="13"
               Foreground="{DynamicResource PixelBrushText}"
               TextWrapping="Wrap" />
    <ContentControl x:Name="ControlHost"
                    Grid.Row="0"
                    Grid.Column="1" />
    <TextBlock x:Name="DescriptionBlock"
               Grid.Row="1"
               Grid.Column="1"
               Margin="0,4,0,0"
               FontSize="12"
               Foreground="{DynamicResource PixelBrushTextSecondary}"
               LineHeight="18"
               TextWrapping="Wrap" />
  </Grid>
</UserControl>
