<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pixel_Craft_Launcher.App"
             xmlns:local="using:Pixel_Craft_Launcher"
             RequestedThemeVariant="Default">
    
    <Application.Resources>
        <ResourceDictionary>
            <!--TODO Markdown-->
            <x:Double x:Key="BlurRadius">0.0</x:Double>
            <x:Double x:Key="BlurSamplingRate">0.7</x:Double>
        </ResourceDictionary>
    </Application.Resources>
    
    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>